    "from dotenv import load_dotenv\n",
    "from openai import AsyncOpenAI\n",
    "from agents import Agent, Runner, OpenAIChatCompletionsModel, RunConfig\n",
    "from agents.tracing import add_trace_processor, TracingProcessor, set_trace_processors\n",
    "from datetime import datetime\n",
    "import os\n",
    "\n",
    "load_dotenv(override=True)\n",
    "\n",
    "client = AsyncOpenAI(\n",
    "    base_url=\"https://models.inference.ai.azure.com\",\n",
    "    api_key=os.getenv(\"GITHUB_TOKEN\"),\n",
    ")\n",
    "\n",
    "# Local console tracer — prints trace/span info instead of uploading to OpenAI\n",
    "class ConsoleTraceProcessor(TracingProcessor):\n",
    "    def on_trace_start(self, trace) -> None:\n",
    "        print(f\"[TRACE START] {trace.name}  (id={trace.trace_id})\")\n",
    "\n",
    "    def on_trace_end(self, trace) -> None:\n",
    "        print(f\"[TRACE END]   {trace.name}\")\n",
    "\n",
    "    def on_span_start(self, span) -> None:\n",
    "        print(f\"  --> [SPAN] {type(span.span_data).__name__}\")\n",
    "\n",
    "    def on_span_end(self, span) -> None:\n",
    "        try:\n",
    "            start = datetime.fromisoformat(span.started_at)\n",
    "            end = datetime.fromisoformat(span.ended_at)\n",
    "            duration = (end - start).total_seconds()\n",
    "            print(f\"  <-- [SPAN] {type(span.span_data).__name__}  ({duration:.2f}s)\")\n",
    "        except Exception:\n",
    "            print(f\"  <-- [SPAN] {type(span.span_data).__name__}\")\n",
    "\n",
    "    def shutdown(self) -> None:\n",
    "        pass\n",
    "\n",
    "    def force_flush(self, timeout_secs: float = 30) -> None:\n",
    "        pass\n",
    "\n",
    "# Replace all processors (not accumulate) so re-runs don't stack old instances\n",
    "set_trace_processors([ConsoleTraceProcessor()])\n",
    "\n",
    "agent = Agent(\n",
