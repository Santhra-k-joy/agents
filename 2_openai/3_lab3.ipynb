    "## OPTIONAL EXTRA: Sandbox Agents\n",
    "\n",
    "This example will only work on Windows + WSL2, or Mac, or Linux\n",
    "\n",
    "https://openai.github.io/openai-agents-python/sandbox_agents/\n",
    "\n",
    "This is an execution harness - a runtime - \"a persistent workspace where it can search large document sets, edit files, run commands, generate artifacts, and pick work back up from saved sandbox state.\"\n",
    "\n",
    "You have to set up:\n",
    "1. Manifest: the workspace\n",
    "2. Capabilities: what it can do\n",
    "3. SandboxRunConfig: where it runs"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from pathlib import Path\n",
    "from agents.run import RunConfig\n",
    "from agents.sandbox import Manifest, SandboxAgent, SandboxRunConfig, SandboxPathGrant\n",
    "from agents.sandbox.capabilities import Capabilities\n",
    "from agents.sandbox.entries import LocalDir\n",
    "from agents.sandbox.sandboxes.unix_local import UnixLocalSandboxClient"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "CODE_DIR = Path(\"code\").resolve()\n",
    "OUTPUT_DIR = Path(\"output\").resolve()\n",
    "if not OUTPUT_DIR.exists():\n",
    "    OUTPUT_DIR.mkdir()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "CODE_DIR"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "instructions = f\"\"\"\n",
    "You are a software engineer that fixes bugs.\n",
    "Review files in the sandbox code directory.\n",
    "\n",
    "Write the fixed version of the file to this host output directory:\n",
    "{OUTPUT_DIR}\n",
    "\n",
    "Use full file paths when writing output.\n",
    "Respond with a summary of what you did.\n",
    "\"\"\""
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "manifest = Manifest(entries={\"code\": LocalDir(src=CODE_DIR)}, extra_path_grants=[SandboxPathGrant(path=str(OUTPUT_DIR))])\n",
    "capabilities = Capabilities.default()\n",
    "capabilities"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "run_config = RunConfig(sandbox=SandboxRunConfig(client=UnixLocalSandboxClient()), workflow_name=\"Sandbox coding example\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "agent = SandboxAgent(name=\"Engineer\", instructions=instructions, model=\"gpt-5.4-mini\", default_manifest=manifest, capabilities=capabilities)"
