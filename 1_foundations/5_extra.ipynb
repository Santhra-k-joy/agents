    "def get_checklist_report() -> str:\n",
    "    result = \"\"\n",
    "    for index, item in enumerate(checklist):\n",
    "        if completed[index]:\n",
    "            result += f\"Checklist #{index + 1}: [green][strike]{item}[/strike][/green]\\n\"\n",
    "        else:\n",
    "            result += f\"Checklist #{index + 1}: {item}\\n\"\n",
    "    show(result)\n",
    "    return result"
   ]
  },
