   "source": [
    "def create_checklist(descriptions: list[str]) -> str:\n",
    "    checklist.extend(descriptions)\n",
    "    completed.extend([False] * len(descriptions))\n",
    "    return get_checklist_report()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "aa4d97e6",
   "metadata": {},
   "outputs": [],
   "source": [
    "def mark_complete(index: int, completion_notes: str) -> str:\n",
    "    if 1 <= index <= len(checklist):\n",
    "        completed[index - 1] = True\n",
    "    else:\n",
    "        return \"No checklist at this index.\"\n",
    "    Console().print(completion_notes)\n",
    "    return get_checklist_report()"
   ]
  },
